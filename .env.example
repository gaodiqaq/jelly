# 在此填入你的 API Key（支持任意 litellm 兼容的提供商）
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# 可选：覆盖默认模型（litellm 格式，必须带提供商前缀）
# AGENT_MODEL=anthropic/claude-sonnet-4-5
# AGENT_MODEL=openai/gpt-4o-mini
# AGENT_MODEL=deepseek/deepseek-chat

# 可选：权限模式 ask / auto / deny
# AGENT_PERMISSION=ask

# 可选：覆盖默认工作目录
# AGENT_CWD=D:\Agent-learning\code

# ---- Web 服务（agent web）----
# 单用户模式：所有访问者共用一个令牌（无会话隔离）
# AGENT_WEB_TOKEN=your-secret-token

# 多用户模式（优先于 AGENT_WEB_TOKEN）：格式 "用户名:口令,用户名:口令"
# 每个用户会话互相隔离；未配置二者时 Web 服务不校验令牌
# AGENT_WEB_USERS=alice:token1,bob:token2

# 监听地址与端口需通过命令行指定：agent web --host 0.0.0.0 --port 8000
