# 在此填入你的 API Key（支持任意 litellm 兼容的提供商）
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# 可选：覆盖默认模型（litellm 格式，必须带提供商前缀）
# AGENT_MODEL=anthropic/claude-sonnet-4-5
# AGENT_MODEL=openai/gpt-4o-mini
# AGENT_MODEL=deepseek/deepseek-chat

# 可选：权限模式 ask / auto / deny
# AGENT_PERMISSION=ask

# 可选：覆盖默认工作目录
# AGENT_CWD=D:\Agent-learning\code

# 可选：Web 新项目自动创建目录的位置（默认 ~/Jelly Projects）
# AGENT_PROJECTS_ROOT=D:\Jelly Projects

# ---- Web 服务（agent web）----
# 推荐：为 Web 工作室设置访问口令。非回环地址未设置口令时会拒绝启动。
# AGENT_WEB_TOKEN=your-secret-token

# 实验性可信团队模式（优先于 AGENT_WEB_TOKEN）：格式 "用户名:口令,用户名:口令"
# 它只隔离会话数据；Provider、Skill 与宿主文件系统仍然共享，不能作为租户安全边界。
# AGENT_WEB_USERS=alice:token1,bob:token2

# 本机使用：agent web --host 127.0.0.1 --port 8000
# 局域网使用前必须设置 AGENT_WEB_TOKEN，再监听 0.0.0.0。
